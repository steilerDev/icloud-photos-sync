{
  "extensionsToTreatAsEsm": [".ts"],
  "transform": {
    "^.+\\.ts$": ["@swc/jest", {
      "jsc": {
        "parser": {"syntax": "typescript"},
        "target": "es2024",
        "keepClassNames": true,
        "transform": {"tsEnumIsMutable": true}
      },
      "module": {"type": "es6"},
      "sourceMaps": "inline"
    }]
  },
  "testEnvironment": "node",
  "setupFilesAfterEnv": ["<rootDir>/test/_helpers/temp-data-dir.setup.ts"],
  "slowTestThreshold": 30,
  "reporters": [
    "default",
    ["jest-ctrf-json-reporter", {
      "outputDir": "coverage/"
    }]
  ],
  "collectCoverage": true,
  "collectCoverageFrom": [
    "src/**/*.ts",
    "!src/main.ts",
    "!src/app/event/**/*",
    "!src/app/error/**/*",
    "!src/lib/photos-library/model/photos-entity.ts"
  ],
  "coverageProvider": "v8",
  "coverageReporters": [
    "text-summary",
    "html",
    "json-summary"
  ],
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1"
  }
}